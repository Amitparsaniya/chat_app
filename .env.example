NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chat_app
DB_POOL_MAX=10
DB_SSL=false

# JWT authentication. Use a long random secret in production.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=chat-backend

# Firebase Admin SDK: either provide a service-account JSON file path...
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
# ...or use Application Default Credentials and set FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firestore collection names
FIRESTORE_CHATS_COLLECTION=chats
