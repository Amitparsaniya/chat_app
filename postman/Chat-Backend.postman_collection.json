{
  "info": {
    "name": "Chat Backend API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "token",
      "value": "PASTE_JWT_HERE"
    },
    {
      "key": "chatId",
      "value": "PASTE_CHAT_UUID"
    },
    {
      "key": "messageId",
      "value": "PASTE_FIRESTORE_MESSAGE_ID"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Create or get chat",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"userAId\":\"user-1\",\"userBId\":\"user-2\"}"
        },
        "url": "{{baseUrl}}/chat/create"
      }
    },
    {
      "name": "Send message",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"senderId\":\"user-1\",\"text\":\"Hello!\"}"
        },
        "url": "{{baseUrl}}/chat/{{chatId}}/message/send"
      }
    },
    {
      "name": "Get messages",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/chat/{{chatId}}/messages?limit=50"
      }
    },
    {
      "name": "Mark read",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"userId\":\"user-2\"}"
        },
        "url": "{{baseUrl}}/chat/{{chatId}}/message/{{messageId}}/read"
      }
    },
    {
      "name": "Update last seen",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"userId\":\"user-2\",\"messageId\":\"{{messageId}}\"}"
        },
        "url": "{{baseUrl}}/chat/{{chatId}}/lastseen"
      }
    },
    {
      "name": "List user chats",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/user/user-1/chats"
      }
    }
  ]
}